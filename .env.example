# CivicPulse AI Environment Configuration Template

# Server & Security
SECRET_KEY=civicpulse-secret-key-production-ready-2026-bengaluru
PROJECT_NAME="CivicPulse AI"
VERSION="1.0.0"

# Database Configuration
# Default: Local SQLite database (Zero setup required)
DATABASE_URL=sqlite:///./civicpulse.db
# Preferred Production (Docker / PostGIS):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicpulse_postgis

# Google Gemini AI Integration (Optional)
# If provided, CivicPulse uses Google GenAI SDK for road defect triage and multimodal image analysis.
# If omitted or empty, the application automatically uses the deterministic heuristic rule-based engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Reverse Geocoding (OpenStreetMap Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CivicPulse-AI-Platform/1.0 (infrastructure-intelligence)

# Default Demo Administrator Credentials
ADMIN_EMAIL=admin@civicpulse.ai
ADMIN_PASSWORD=Admin@CivicPulse2026!
ADMIN_NAME="Dr. Monish Kumar (Lead Director)"

# Risk Priority Formula Weights (Version 1.0)
RISK_WEIGHT_SEVERITY=0.35
RISK_WEIGHT_EXPOSURE=0.25
RISK_WEIGHT_CRITICALITY=0.20
RISK_WEIGHT_HAZARD=0.10
RISK_WEIGHT_TIME_UNRESOLVED=0.10

